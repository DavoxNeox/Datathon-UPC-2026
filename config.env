# Math on the Edge: shared settings for the board scripts and the Python copilot.
# Bash sources this file, and copilot/config.py parses it. Keep it KEY=VALUE.
# Every team starts from the same pinned versions, so results are comparable.

# llama.cpp, pinned to a commit tested on the UNO Q 4 GB (November 2026)
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp
LLAMA_CPP_REF=2cbe0ec429b849a88664e0f62388fc92a5abd699
LLAMA_CPP_DIR=~/llama.cpp

MODELS_DIR=~/models

# Small language model: Qwen3.5 0.8B, Q8_0 (835 MB)
LLM_REPO=bartowski/Qwen_Qwen3.5-0.8B-GGUF
LLM_REVISION=f36b1ea49a332ede8fe5f389bbf5b3575ef71f48
LLM_FILE=Qwen_Qwen3.5-0.8B-Q8_0.gguf
LLM_SHA256=7182e2362766bb9569209bbc24cf1a4cdfbb8ab161babdb2080c84fa62c08c2f
LLM_ALIAS=qwen3.5-0.8b
# Where the Python code finds the servers. auto = 127.0.0.1 on the board and on laptops; inside the
# App Lab container (its own Docker network) auto = msgpack-rpc-router, Docker's host-gateway, where
# board/relay.py (math-relay.service) forwards to the servers. Nothing listens on the Wi-Fi address.
LLM_HOST=auto
EMBED_HOST=auto
LLM_PORT=8081
# One slot with 4096 tokens: enough for a problem, its options and a few examples
LLM_CTX=4096
LLM_THREADS=4
# Optional second server that can see images (see the Explorer section of the README)
VISION_PORT=8083

# Embedding model: bge-small-en-v1.5, Q8_0 (37 MB, 384 dimensions)
EMBED_REPO=CompendiumLabs/bge-small-en-v1.5-gguf
EMBED_REVISION=d32f8c040ea3b516330eeb75b72bcc2d3a780ab7
EMBED_FILE=bge-small-en-v1.5-q8_0.gguf
EMBED_SHA256=ec38e8da142596baa913124ae50550de284b6916bf59577ef2f0cb9660c2f514
EMBED_PORT=8082
# bge-small was trained on 512 tokens; longer problem texts are cut
EMBED_CTX=512
EMBED_THREADS=4
# bge-small expects this prefix on search queries, but not on stored documents
EMBED_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# Official run rules
TIME_LIMIT_SECONDS=60
SEED=42
# Most common answer in M3Kang high_quality (D, 24.6%): used when a problem times out
FALLBACK_ANSWER=D

# Where the code runs: auto detects the UNO Q from /proc/device-tree/model (board), else sim
# (laptop, servers started by dev/start_servers.sh). Force it with RUNTIME=sim or RUNTIME=board.
RUNTIME=auto

# Board speed, measured on our Arduino UNO Q 4 GB on 14 Nov 2026 with board/calibrate_speed.py
# (llama.cpp 2cbe0ec, the systemd flags): medians of 2 rounds. Prompts of 119 to 269 tokens were
# read at 11.3 to 11.6 tok/s, 52 tokens were written at 5.6 to 5.7 tok/s, one embedding request took
# 0.10 to 0.15 s (0.05 s per text in a batch of 20). The README's figures were 11, about 6, and a
# fraction of a second. copilot/board_clock.py turns token counts into seconds with these.
BOARD_PREFILL_TPS=11.4
BOARD_GEN_TPS=5.6
BOARD_EMBED_SECONDS=0.12

# Board RAM, for dev/ram_budget.py. Available after boot is from README step 1.1.
# The App Lab reserve is a placeholder until it is measured on the board (Phase 10).
BOARD_RAM_AVAILABLE_MB=3100
BOARD_APP_LAB_RESERVE_MB=500

# Letter-bias calibration written by calibrate_bias.py. Empty or missing file = raw baseline.
LETTER_BIAS_PRIOR=data_curated/letter_prior.json

# Official-run policy when no family solver applies: 1 = ask the model for a letter,
# 0 = answer FALLBACK_ANSWER without calling it. Measured on 281 English validation
# problems (14 Nov 2026): model letter 21.7%, always D 23.1%, bias-corrected 17.8%.
LETTER_MODEL=0

# Middle-value rule (copilot/ladder.py): when the five options are distinct numbers, answer the middle
# one instead of FALLBACK_ANSWER; any other problem still gets FALLBACK_ANSWER. A prior on how Kangaroo
# distractors are built (the right value usually has distractors above and below it), not reasoning.
# Measured 14 Nov 2026: train 405/1466 = 27.6% against always D 367 = 25.0%; the held-out 281 English
# validation problems 77/281 = 27.4% against 65 = 23.1% (bootstrap 95% of the gain: see
# docs/reason-experiments.md; a hidden test can return it to zero). 1 = on (default), 0 = off.
MIDDLE_VALUE=1
# Learned option prior (copilot/prior.py, table data_curated/option_prior.json from laptop/learn_prior.py): per stratum
# (level, picture, kind of options) the rule that beat the middle-value rule by 10+ training problems, applied before it.
# Measured 14 Nov 2026 (experiment 5): validation 80/281 against 77, bootstrap 95% of the gain [-4, +11], 27% of
# resamples at or under zero; 5-fold cross-validation inside train: no gain. Off until a version clearly wins.
OPTION_PRIOR=0
# Experiments on the options (copilot/votes.py, docs/reason-experiments.md), off by default: neither beat
# always D on the 281 validation problems. VOTE_SHIFTS=5: one letter per cyclic shift of the options,
# strict majority of VOTE_MIN votes, else fall through. VALUE_MODEL=1: ask for the correct option's
# value with a grammar limited to the five option strings. Both skip a problem whose board estimate
# would pass EXPERIMENT_BUDGET_SECONDS (measured: without it 6 of 281 passed 60 s with 5 shifts).
VOTE_SHIFTS=0
VOTE_MIN=3
VALUE_MODEL=0
EXPERIMENT_BUDGET_SECONDS=50
# Brief reasoning by the 0.8B itself (copilot/think.py, docs/reason-experiments.md Experiment 6 and 7): the
# model writes a few lines of working in English and the letter is read from them, in one request whose
# output is capped so prompt plus output fit EXPERIMENT_BUDGET_SECONDS on the board. THINK_LEVELS lists the
# M3Kang levels (0 to 7, comma-separated; "all"; empty = off) on which it runs; THINK_TEXT_ONLY=1 keeps it to
# problems without a figure. Any skip, timeout, error or unreadable working falls back to the policy above.
THINK_LEVELS=
THINK_TEXT_ONLY=1
# THINK_NUMERIC=0 keeps the stage off the problems whose five options are distinct numbers (the middle-value
# prior answers those). THINK_STYLE picks the instruction (copilot/think.INSTRUCTIONS): short (plain text, 60 words:
# 70 of 179 workings cut at the cap on the training sample, against 95 with steps) or steps (the first prompt).
THINK_NUMERIC=1
THINK_STYLE=short
# Board seconds the stage may spend on a problem, minus what it already cost. Measured on the board (Experiment
# 6): real time is 0.99 to 1.10 of the estimate on completed requests, and one request estimated at 49.5 s hit
# the 57 s HTTP timeout (generation ran at 5.4 tok/s, the prompt cache was cold), so 45 keeps the worst case
# under 52 s. THINK_MAX_TOKENS caps the working; fewer than THINK_MIN_TOKENS left means no request at all.
THINK_BUDGET_SECONDS=45
# Board seconds (estimate) a family solver's extraction may cost; above it the solver is skipped and the rest of
# the policy answers. On the board one extraction estimated at 28.8 s took 38.2 s (1.33x: grammar-constrained
# JSON, cold cache), so 42 keeps the real worst case near 56 s; the HTTP timeout at 57 s is the backstop.
SOLVER_BUDGET_SECONDS=42
THINK_MAX_TOKENS=200
THINK_MIN_TOKENS=80

# Hint ladder (copilot/hints.py, branch hints-app)
# Rung 3 asks the LLM only for topics whose human-judged quality (data_curated/hint_quality.json) reaches this percentage
HINT_QUALITY_MIN=70
# Longest LLM hint, in generated tokens (one short sentence)
HINT_MAX_TOKENS=40
# Retry a leaking hint only when the first attempt cost less than this many estimated board seconds
HINT_RETRY_BUDGET=30
# What prefetch() does in a thread when a problem is shown: full (write the hint ahead), warm (read the prompt), off
HINT_PREFETCH=full
# en: the model hint is written in English only and shown as is on the Catalan page (its Catalan is poor); empty: page language
HINT_LLM_LANG=
# Web port of the sim-mode app (port 7000 is AirPlay on macOS; the board's web_ui brick uses 7000)
SIM_WEB_PORT=7001

# LED matrix animator (copilot/hal/led.py): 1 = a thread animates the matrix (breathing when the mastery map is
# empty, hint blocks, a running dot while a hint is prepared, the chosen letter before the tick or cross, bars that
# grow); 0 = the final frame only, synchronously (the tests).
LED_ANIMATE=1

# Hint button uses per problem on the web (rung 0, the other language, and the explicit solution do not count)
HINT_MAX_USES=4
# The 4th use is a short theory lesson of the topic (data_curated/lessons.json), not a hint
HINT_LESSON_ON_LAST=1


# Empirical difficulty (copilot/difficulty.py): 1 = the trainer's adaptive rule reads each problem's
# level as the level adjusted to this class's own answers (3+ answers on the problem); 0 = M3Kang level.
# Measured only on a simulated class (docs/difficulty.md); the recommended use is the teacher's report().
DIFFICULTY_ADJUST=0
